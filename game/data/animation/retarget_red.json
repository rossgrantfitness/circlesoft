{
 "_about": "Retarget of the free Quaternius Universal Animation Library (CC0) onto Red. Read by scripts/tools/retarget_ual.py. Edit this file and rerun the tool; nothing else needs to change.",
 "target": "art/final/characters/red/red_ross_v1_rigged.glb",
 "output": "art/final/characters/red/red_ross_v1_rigged_ual.glb",
 "clip_keys": "data/combat/red_clip_keys.json",
 "clip_keys_about": "Key poses of Red's clips: where the strike lands (contact_s) and the poses the move data snaps to. 30 fps for Quaternius clips (retarget_ual.py), 15 fps stepped for the TA's hand-posed stand-ins. Use these seconds as clip_s in moves.json anim.keys.",
 "sources": {
  "UAL1": "art/placeholder/animations/quaternius_ual/UAL1_Standard.glb",
  "UAL2": "art/placeholder/animations/quaternius_ual/UAL2_Standard.glb"
 },
 "fps": 30,
 "hips": {"target": "hips", "source": "pelvis", "scale": 0.41},
 "ground": {
  "scale": 0.41,
  "target_soles": {
   "foot_l": {"heel": [0, -0.051, -0.09], "toe": [0, -0.051, 0.11]},
   "foot_r": {"heel": [0, -0.051, -0.09], "toe": [0, -0.051, 0.11]}
  },
  "source_soles": {
   "foot_l": {"heel": [0, -0.104, -0.02], "toe": [0, -0.104, 0.2]},
   "foot_r": {"heel": [0, -0.104, -0.02], "toe": [0, -0.104, 0.2]}
  }
 },
 "bones": [
  {"target": "hips", "source": "pelvis"},
  {"target": "spine", "source": "spine_02"},
  {"target": "chest", "source": "spine_03"},
  {"target": "neck", "source": "neck_01"},
  {"target": "head", "source": "Head"},
  {"target": "shoulder_{s}", "source": "clavicle_{s}"},
  {"target": "upper_arm_{s}", "source": "upperarm_{s}", "t_dir": "forearm_{s}", "to": [1, 0, 0]},
  {"target": "forearm_{s}", "source": "lowerarm_{s}", "t_dir": "hand_{s}", "to": [1, 0, 0]},
  {"target": "hand_l", "source": "hand_l", "t_dir": "parent", "to": [1, 0, 0]},
  {"target": "hand_r", "source": "hand_r", "t_dir": "parent", "to": [-1, 0, 0], "blade_socket": "weapon_socket", "blade_dir_in_source_rest": [0, 0, 1]},
  {"target": "thigh_{s}", "source": "thigh_{s}"},
  {"target": "shin_{s}", "source": "calf_{s}"},
  {"target": "foot_{s}", "source": "foot_{s}"}
 ],
 "clips": [
  {"name": "idle", "source": "UAL1:Sword_Idle", "loop": true},
  {"name": "run", "source": "UAL1:Sprint_Loop", "loop": true}
 ],
 "keep_standins": ["launcher"]
}
