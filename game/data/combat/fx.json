{
  "version": 1,
  "_note": "Combat FX numbers (docs/pivot/combat_api.md 4.6, 4.7, 4.8; Technical Artist). Read by scripts/combat/fx/combat_fx.gd, and by OrbitCamera for `shake.<id>` (amplitude_m, duration_s, frequency_hz). Distances in metres, times in seconds of REAL time unless it says 'combat clock'. Colours are hex. Anything above the glow threshold blooms in the PS2 look, so 'intensity' and 'glow' values above 1 are the bright ones. Names and numbers are Level 1: change freely.",
  "shake": {
    "light":         {"amplitude_m": 0.025, "duration_s": 0.12, "frequency_hz": 26.0},
    "medium":        {"amplitude_m": 0.042, "duration_s": 0.16, "frequency_hz": 24.0},
    "heavy":         {"amplitude_m": 0.06,  "duration_s": 0.20, "frequency_hz": 22.0},
    "launch":        {"amplitude_m": 0.085, "duration_s": 0.26, "frequency_hz": 20.0},
    "slam":          {"amplitude_m": 0.13,  "duration_s": 0.36, "frequency_hz": 16.0},
    "air":           {"amplitude_m": 0.035, "duration_s": 0.14, "frequency_hz": 24.0},
    "parry":         {"amplitude_m": 0.04,  "duration_s": 0.14, "frequency_hz": 30.0},
    "perfect_parry": {"amplitude_m": 0.075, "duration_s": 0.22, "frequency_hz": 26.0},
    "flare":         {"amplitude_m": 0.05,  "duration_s": 0.30, "frequency_hz": 14.0},
    "death":         {"amplitude_m": 0.05,  "duration_s": 0.18, "frequency_hz": 20.0}
  },
  "sparks": {
    "_note": "streak bursts. count, speed [min, max] m/s, life_s, length_m and width_m of each streak, gravity m/s2, cone_deg around the hit normal, flash = the bright pop (size_m, life_s, intensity), ring = optional expanding ring.",
    "slash":         {"color": "#ffe2a8", "core": "#ffffff", "count": 9,  "speed": [3.0, 6.5], "life_s": 0.22, "length_m": 0.30, "width_m": 0.035, "gravity": 6.0, "cone_deg": 70.0, "glow": 2.2, "flash": {"size_m": 0.55, "life_s": 0.09, "intensity": 2.6}},
    "heavy":         {"color": "#ffb347", "core": "#fff2d0", "count": 14, "speed": [4.0, 8.5], "life_s": 0.28, "length_m": 0.40, "width_m": 0.05,  "gravity": 7.0, "cone_deg": 85.0, "glow": 2.4, "flash": {"size_m": 0.85, "life_s": 0.11, "intensity": 3.0}, "ring": {"max_m": 0.9, "life_s": 0.16}},
    "launch":        {"color": "#9fe8ff", "core": "#ffffff", "count": 16, "speed": [4.0, 9.0], "life_s": 0.30, "length_m": 0.42, "width_m": 0.05,  "gravity": 3.0, "cone_deg": 60.0, "glow": 2.4, "flash": {"size_m": 0.95, "life_s": 0.12, "intensity": 3.0}, "ring": {"max_m": 1.1, "life_s": 0.2}},
    "air":           {"color": "#d8f4ff", "core": "#ffffff", "count": 9,  "speed": [3.0, 6.0], "life_s": 0.2,  "length_m": 0.30, "width_m": 0.035, "gravity": 2.0, "cone_deg": 80.0, "glow": 2.2, "flash": {"size_m": 0.5, "life_s": 0.08, "intensity": 2.4}},
    "guard":         {"color": "#9aa8b8", "core": "#e8eef5", "count": 6,  "speed": [2.0, 4.5], "life_s": 0.18, "length_m": 0.22, "width_m": 0.03,  "gravity": 8.0, "cone_deg": 55.0, "glow": 1.4, "flash": {"size_m": 0.35, "life_s": 0.07, "intensity": 1.6}},
    "parry":         {"color": "#fff4c0", "core": "#ffffff", "count": 12, "speed": [4.0, 8.0], "life_s": 0.24, "length_m": 0.36, "width_m": 0.04,  "gravity": 1.0, "cone_deg": 100.0, "glow": 2.6, "flash": {"size_m": 0.8, "life_s": 0.10, "intensity": 3.0}, "ring": {"max_m": 1.0, "life_s": 0.18}},
    "perfect_parry": {"color": "#ffd34a", "core": "#ffffff", "count": 22, "speed": [5.0, 11.0], "life_s": 0.34, "length_m": 0.5, "width_m": 0.055, "gravity": 0.5, "cone_deg": 140.0, "glow": 3.0, "flash": {"size_m": 1.3, "life_s": 0.16, "intensity": 3.6}, "ring": {"max_m": 1.8, "life_s": 0.26}},
    "dodge":         {"color": "#ffcf80", "core": "#ffffff", "count": 8,  "speed": [2.0, 5.0], "life_s": 0.26, "length_m": 0.3,  "width_m": 0.03,  "gravity": 0.0, "cone_deg": 180.0, "glow": 2.0, "flash": {"size_m": 0.6, "life_s": 0.12, "intensity": 2.0}, "ring": {"max_m": 1.2, "life_s": 0.22}},
    "death":         {"color": "#cfe8f2", "core": "#ffffff", "count": 20, "speed": [2.0, 7.0], "life_s": 0.4,  "length_m": 0.35, "width_m": 0.04,  "gravity": 4.0, "cone_deg": 180.0, "glow": 2.2, "flash": {"size_m": 1.1, "life_s": 0.14, "intensity": 2.6}, "ring": {"max_m": 1.4, "life_s": 0.28}}
  },
  "spark_by_outcome": {"armored": "guard", "guarded": "guard", "blocked": "guard", "guard_broken": "heavy", "parried": "parry", "perfect_parry": "perfect_parry"},
  "spark_aliases": {"slash": "slash", "slash_big": "heavy", "slash_up": "launch", "heavy": "heavy", "launch": "launch", "air": "air", "slam": "heavy"},
  "telegraph": {
    "_note": "the wind-up flash and the converging ring that lands exactly on impact: a parry cue. kinds are picked by info.telegraph_kind, else 'parryable' / 'unparryable' from the signal; add kinds freely (dodge_only, unblockable ...) and the cue appears with no code change.",
    "anchor": "head", "flash_life_s": 0.16, "ring_from_m": 1.5, "ring_to_m": 0.3, "min_lead_s": 0.12,
    "kinds": {
      "parryable":   {"color": "#ffd34a", "flash_size_m": 0.8, "intensity": 3.0, "ring_intensity": 2.4},
      "unparryable": {"color": "#ff4d6d", "flash_size_m": 1.0, "intensity": 3.2, "ring_intensity": 2.6},
      "dodge_only":  {"color": "#ff4d6d", "flash_size_m": 1.0, "intensity": 3.2, "ring_intensity": 2.6},
      "unblockable": {"color": "#ff4d6d", "flash_size_m": 1.1, "intensity": 3.4, "ring_intensity": 2.8}
    }
  },
  "flare": {
    "_note": "the Lamp Flare: a lamp burst on Red, a shock ring, and a cooler, calmer world while enemies run slow. Envelope: burst_s ramps to the peak, then holds, then fades over fade_s at the end.",
    "burst_s": 0.22, "fade_s": 0.4,
    "lamp": {"color": "#ffb347", "energy_peak": 9.0, "energy_hold": 2.6, "range_m": 10.0},
    "ring": {"color": "#ffd38a", "max_m": 7.0, "life_s": 0.5, "intensity": 2.4},
    "flash": {"color": "#fff0c8", "size_m": 2.4, "life_s": 0.16, "intensity": 3.2},
    "environment": {"saturation": 0.72, "brightness": 0.94, "glow_boost": 0.35},
    "anchor": "lamp"
  },
  "lights_on": {
    "_note": "Lights On: Red's edge light and the neon strips on her jacket brighten, her lamp stays lit, a burst on activation.",
    "rim_mult": 1.9, "emissive_pick": 1.6,
    "lamp": {"color": "#ffd27a", "energy": 2.4, "range_m": 6.5},
    "burst": {"color": "#ffd27a", "ring_m": 3.0, "life_s": 0.4, "intensity": 2.4}
  },
  "dash": {
    "_note": "speed streaks left behind a dash. heights are metres above her feet.",
    "count": 3, "length_m": 2.4, "width_m": 0.05, "life_s": 0.24, "color": "#cfeaff", "spread_m": 0.2, "heights": [0.25, 0.55, 0.8], "glow": 1.8, "air_color": "#bfe0ff"
  },
  "trail": {"max_age_s": 0.22, "max_samples": 24, "glow": 1.8, "tail_ms": 70, "min_step_m": 0.015},
  "sounds": {
    "_note": "who plays what (combat_api.md 4.6). A move's own sfx / swing.sfx wins over these. The HUD plays combat_noise_rank_up and combat_lock_on, so they are NOT here.",
    "jump": "combat_jump", "land": "combat_land", "dash": "combat_dash", "air_dash": "combat_air_dash",
    "swing_light": "combat_swing_light", "swing_heavy": "combat_swing_heavy",
    "hit_light": "combat_hit_light", "hit_heavy": "combat_hit_heavy", "hit_air": "combat_hit_air", "launch": "combat_hit_launch",
    "parry": "combat_parry", "perfect_parry": "combat_parry_perfect",
    "flare": "combat_lamp_flare", "lights_on": "combat_lights_on_activate",
    "telegraph": "combat_enemy_telegraph", "death": "combat_enemy_death"
  },
  "look": {"add_ps2_look": true, "dress_actors": true}
}
