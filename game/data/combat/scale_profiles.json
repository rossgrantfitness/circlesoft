  },

  "sequences": {
    "_note": "Boarding and docking timelines (seconds). phases are [name, from_s, to_s]; control_at_s is when the player gets the controls back; The dock numbers are the Technical Artist's (robot_scale_test.md section 3): approach 0-1.0, doors 1.0-1.6, hop 1.6-2.8, snap 2.8-3.0, lock 3.0-3.6, power-up 3.6-4.5. Undock is the same in reverse.",
    "board": {
      "phases": [["step", 0.0, 0.35], ["hatch_open", 0.35, 0.8], ["climb", 0.8, 1.7], ["hatch_close", 1.7, 2.1], ["power_up", 2.1, 3.0]],
      "control_at_s": 2.8,
      "swap_at_s": 2.1,
      "climb_height_m": 1.2
    },
    "disembark": {
      "phases": [["power_down", 0.0, 0.4], ["hatch_open", 0.4, 0.8], ["climb", 0.8, 1.6], ["hatch_close", 1.6, 2.0]],
      "control_at_s": 1.7,
      "climb_height_m": 1.2
    },
    "dock": {
      "phases": [["approach", 0.0, 1.0], ["doors", 1.0, 1.6], ["hop", 1.6, 2.8], ["snap", 2.8, 3.0], ["lock", 3.0, 3.6], ["power_up", 3.6, 4.5]],
      "control_at_s": 4.3,
      "swap_at_s": 3.6,
      "hop_height_m": 6.0,
      "hit_stop_s": 0.08,
      "door_open_deg": 100.0,
      "camera_cues": [
        {"at_s": 1.6, "view": "dock_lift", "blend_s": 1.2, "world": "huge", "world_blend_s": 2.0}
      ]
    },
    "undock": {
      "phases": [["power_down", 0.0, 0.6], ["doors", 0.6, 1.2], ["hop", 1.2, 2.4], ["doors_close", 2.4, 3.0]],
      "control_at_s": 2.8,
      "swap_at_s": 2.4,
      "hop_height_m": 6.0,
      "door_open_deg": 100.0,
      "camera_cues": [
        {"at_s": 0.0, "view": "dock_lift", "blend_s": 1.0},
        {"at_s": 2.2, "view": "small", "blend_s": 1.2, "world": "small", "world_blend_s": 1.5}
      ]
    },
    "hatch_open_deg": -100.0
  },

  "boarding": {
    "_note": "How Red gets into the loader: walk into the ring at the boarding point (or press interact, E, within interact_radius_m). After climbing out she must step out of the ring once before it will take her again. dock_trigger_m: how close the loader must get to the colossus's dock_approach point for the docking to start by itself. disembark is the Q button (pad: left stick click).",
    "enter_radius_m": 1.15,
    "interact_radius_m": 2.6,
    "dock_trigger_m": 3.5,
    "disembark_action": "disembark",
    "disembark_max_speed_mps": 1.5,
