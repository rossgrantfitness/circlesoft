{
  "_about": "Speech bubbles, the plain text box and the dialogue runner's tunables. Sizes are internal pixels (384x216). Colors are palette names from ui/ui_theme.json. Speaker ids match data/dialogue/*.json.",
  "typing": {
    "_note": "chars_per_second per Config text speed. Pauses are seconds added after a punctuation mark that ends a word.",
    "speeds": {"slow": 18, "normal": 36, "fast": 80},
    "default_speed": "normal",
    "pauses": {",": 0.1, ";": 0.1, ":": 0.1, "-": 0.05, ".": 0.24, "!": 0.24, "?": 0.24, "…": 0.24}
  },
  "bubble": {
    "font": "dialogue",
    "line_height": 14,
    "max_text_width": 296,
    "max_lines": 3,
    "min_text_width": 28,
