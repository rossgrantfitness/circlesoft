    "otis": {"name": "Otis", "accent": "#E0782B", "head_height": 1.47, "style": "bubble", "voice": true},
    "mox": {"name": "Mox", "accent": "#C9A23A", "head_height": 1.37, "style": "bubble", "voice": true},
    "zero_old": {"name": "Old Zero", "accent": "#CBA878", "head_height": 1.16, "style": "bubble", "voice": true},
    "sign": {"name": "Sign", "accent": "#8D97A5", "head_height": 1.0, "style": "box", "voice": false},
    "narrator": {"name": "", "accent": "chalk", "head_height": 1.0, "style": "box", "voice": false}
