{
  "_about": "Speech bubbles, the plain text box and the dialogue runner's tunables. Sizes are internal pixels (384x216). Colors are palette names from ui/ui_theme.json. Speaker ids match data/dialogue/*.json.",
  "typing": {
    "_note": "chars_per_second per Config text speed. Pauses are seconds added after a punctuation mark that ends a word.",
    "speeds": {"slow": 18, "normal": 36, "fast": 80},
    "default_speed": "normal",
    "pauses": {",": 0.1, ";": 0.1, ":": 0.1, "-": 0.05, ".": 0.24, "!": 0.24, "?": 0.24, "…": 0.24}
  },
  "bubble": {
    "font": "dialogue",
    "line_height": 14,
    "max_text_width": 296,
    "max_lines": 3,
    "min_text_width": 28,
    "pad_x": 8,
    "pad_top": 5,
    "pad_bottom": 8,
    "corner": 5,
    "outline": 2,
    "tail_height": 7,
    "tail_half_width": 5,
    "tail_inset": 12,
    "tail_gap": 2,
    "flip_gap": 10,
    "screen_margin": 4,
    "arrow_w": 7,
    "arrow_h": 4,
    "arrow_blink_s": 0.4,
    "pop_scales": [0.5, 1.12, 1.0],
    "close_scales": [0.6],
    "show_name_tag": true,
    "tag_height": 14,
    "tag_pad_x": 4,
    "tag_x": 8,
    "tag_overhang": 7,
    "choice_row_height": 16,
    "choice_indent": 10,
    "choice_gap": 3,
    "colors": {"fill": "chalk", "outline": "ink", "text": "ink", "shadow": "dusk", "select_fill": "ink", "select_text": "lamp_amber", "arrow": "ink"}
  },
  "gesture": {
    "bubble_w": 28,
    "bubble_h": 26,
    "corner": 5,
    "hold_s": 1.2,
    "frame_s": 0.25,
    "choice_hold_s": 0.9
  },
  "box": {
    "_note": "The plain text box for narrator and sign (examine text) and for speakers who are not in the room.",
    "x": 16,
    "y": 150,
    "w": 352,
    "h": 58,
    "text_x": 12,
    "text_y": 7,
    "line_height": 14,
    "max_lines": 3,
    "tag_y": -6,
    "choice_row_height": 14
  },
  "markup": {
    "_note": "Inline tags allowed in dialogue text. {face:grin} changes the speaker's portrait expression at that point in the line.",
    "tags": ["face"]
  },
  "portrait": {
    "_note": "Where portraits show. Sizes and crops are in data/ui/portraits.json. A speaker gets one when its entry below has a 'portrait' key (a character in portraits.json).",
    "in_bubble": true,
    "in_box": true
  },
  "fast_forward": {
    "_note": "Hold one of these buttons (seconds to hold before it counts) to speed through text: each page shows at once, then turns by itself. Choices always wait for you. A press that was already down when the bubble opened is ignored until it is let go.",
    "actions": {"cancel": 0.12, "confirm": 0.45},
    "page_delay_s": 0.09,
    "advance_lines": true,
    "line_delay_s": 0.12,
    "gesture_hold_s": 0.25
  },
  "auto_advance": {
    "_note": "Config 'Auto-advance': a finished page turns by itself after base_s + per_char_s for every character, kept between min_s and max_s. Choices always wait for you.",
    "base_s": 0.7,
    "per_char_s": 0.035,
    "min_s": 0.9,
    "max_s": 6.0
  },
  "crowd": {
    "_note": "Speaker ids that start with a prefix here are crowd NPCs: plain bottom box, no portrait, name tag from the rest of the id.",
    "prefixes": ["crowd_"]
  },
  "crowd_speaker": {"accent": "#8D97A5", "style": "box", "voice": true},
  "sfx": {"open": "bubble_open", "next": "bubble_next", "item": "item_get", "choice": "menu_tick", "pick": "menu_confirm"},
  "default_speaker": {"name": "", "accent": "chalk", "head_height": 1.0, "style": "bubble", "voice": true},
  "speakers": {
    "red": {"name": "Red", "accent": "#C8322A", "head_height": 1.0, "style": "bubble", "voice": false, "portrait": "red"},
    "otis": {"name": "Otis", "accent": "#E0782B", "head_height": 1.47, "style": "bubble", "voice": true, "portrait": "otis"},
    "mox": {"name": "Mox", "accent": "#C9A23A", "head_height": 1.37, "style": "bubble", "voice": true, "portrait": "mox"},
    "zero_old": {"name": "Old Zero", "accent": "#CBA878", "head_height": 1.16, "style": "bubble", "voice": true, "portrait": "zero_old"},
    "kasp": {"name": "Kasp", "accent": "#7A5A3A", "head_height": 1.3, "style": "bubble", "voice": true, "portrait": "kasp"},
    "vela": {"name": "Vela", "accent": "#7FB6C9", "head_height": 1.0, "style": "box", "voice": true},
    "sign": {"name": "Sign", "accent": "#8D97A5", "head_height": 1.0, "style": "box", "voice": false},
    "narrator": {"name": "", "accent": "chalk", "head_height": 1.0, "style": "box", "voice": false},
    "enemy_grunt": {"name": "Grunt", "accent": "#8D97A5", "head_height": 1.7, "style": "bubble", "voice": true},
    "enemy_drone": {"name": "Drone", "accent": "#6F8BA8", "head_height": 1.4, "style": "bubble", "voice": true},
    "enemy_squad": {"name": "Squad Boss", "accent": "#C9A23A", "head_height": 1.7, "style": "bubble", "voice": true},
    "enemy_tough": {"name": "Enforcer", "accent": "#C8322A", "head_height": 1.4, "style": "bubble", "voice": true}
  }
}
