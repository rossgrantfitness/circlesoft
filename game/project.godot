; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lights Left On"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="LightsLeftOn"

[autoload]

DataDB="*res://scripts/core/data_db.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Config="*res://scripts/core/config.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[importer_defaults]

scene={
"animation/fps": 15,
"gltf/embedded_image_handling": 3,
"import_script/path": "res://scripts/tools/psx_post_import.gd",
"meshes/create_shadow_meshes": false,
"meshes/ensure_tangents": false,
"meshes/generate_lods": false
}
texture={
"compress/mode": 0,
"mipmaps/generate": false
}

